# SQLite DB (regenerable from schema + parsers)
db/modeldb.sqlite
db/modeldb.sqlite-wal
db/modeldb.sqlite-shm

# Append-only raw snapshots (large; regenerable)
data/raw/

# Python
__pycache__/
*.pyc
.venv/
.python-version

# Secrets — never commit API keys
.env
*.key

# OS
.DS_Store

# Notebook checkpoints
.ipynb_checkpoints/

# Node deps (declared in package.json + bun.lock)
node_modules/

# SVG render intermediates (byproduct of jsdom->rsvg PNG pipeline)
viz/out/*.svg
viz/bakeoff/*.svg

# Dashboard build artifacts (regenerable via `bun run dash:build`)
dashboard/dist/
dashboard/public/data/
